    "ws": "^8.18.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@google/genai": "^2.30.0",
    "@karinjs/node-schedule": "^1.1.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "chokidar": "^4.0.3",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.9.0",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
