{
  "name": "@syfantasy/chaite",
  "version": "2.1.0",
  "description": "Chaite - Standalone AI Agent & Multi-Protocol Bot System",
  "author": "syfantasy",
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    }
  },
  "bin": {
    "chaite": "./dist/index.js"
  },
  "files": [
    "dist",
    "frontend/build"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "start": "NODE_OPTIONS='--max-old-space-size=768' tsx src/index.ts",
    "dev": "NODE_OPTIONS='--max-old-space-size=768' tsx watch src/index.ts",
    "build": "tsc --outDir dist --declaration",
    "prepublishOnly": "tsc --outDir dist --declaration",
    "build:web": "pnpm --prefix web build",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@electric-sql/pglite": "^0.3.16",
    "@google/genai": "^2.32.0",
    "@karinjs/node-schedule": "^1.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.21.1",
    "chokidar": "^4.0.3",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "jszip": "3.10.1",
    "mammoth": "^1.13.0",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "ws": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
